        "jsCode": "// Pass Twenty's records through unchanged (the app's adapter maps them),\n// plus paging info. Twenty REST answers { data: { tasks: [...] }, totalCount, pageInfo }.\nconst validated = $('Validate Input').first().json;\nconst r = $input.first().json || {};\nconst tasks = (r.data && Array.isArray(r.data.tasks)) ? r.data.tasks : [];\nreturn [{ json: {\n  ok: true,\n  request_id: validated.request_id,\n  duration_ms: Date.now() - (validated._startTime || Date.now()),\n  data: { count: tasks.length, totalCount: r.totalCount ?? null, pageInfo: r.pageInfo || null, tasks }\n} }];"
