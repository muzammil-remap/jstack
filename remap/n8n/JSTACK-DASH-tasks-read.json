      "parameters": {
        "jsCode": "// DASHBOARD tasks read (read-only): one page of Twenty tasks, passed through\n// as structured records. The app pages with `cursor` and maps fields itself.\nconst first = $input.first().json;\nconst body = first.body || first;\nconst request_id = (typeof body.request_id === 'string') ? body.request_id : undefined;\nconst bad = (message) => [{ json: { valid: false, code: 'VALIDATION_ERROR', message, request_id } }];\n\nlet limit = parseInt(body.limit ?? 60, 10);\nif (isNaN(limit)) return bad('limit must be a number');\nlimit = Math.max(1, Math.min(60, limit));   // Twenty REST pages at 60\n\nconst cursor = body.cursor == null || body.cursor === '' ? null : String(body.cursor);\nif (cursor !== null && cursor.length > 500) return bad('cursor too long');\n\nreturn [{ json: { valid: true, limit, cursor, request_id, _startTime: Date.now() } }];"
      },
