    {
      "parameters": {
        "jsCode": "// op: create | update | delete. Only allow-listed Twenty fields are written.\nconst first = $input.first().json;\nconst body = first.body || first;\nconst request_id = (typeof body.request_id === 'string' && body.request_id.length <= 100) ? body.request_id : undefined;\nconst fail = (code, message, status_code = 400) => [{ json: { valid: false, status_code, error: { code, message }, request_id } }];\nconst isIso = (v) => typeof v === 'string' && v.trim() !== '' && !isNaN(new Date(v).getTime());\nconst BASE = 'http://172.17.0.1:3000/rest/tasks';\nconst STATUS = ['TODO', 'IN_PROGRESS', 'DONE'];\nconst op = body.op;\nif (!['create', 'update', 'delete'].includes(op)) return fail('VALIDATION_ERROR', 'op must be create, update or delete');\n\nfunction pickFields(f) {\n  if (f == null || typeof f !== 'object' || Array.isArray(f)) return { error: 'fields must be an object' };\n  const out = {};\n  if ('title' in f) {\n    if (typeof f.title !== 'string' || f.title.trim() === '' || f.title.length > 300) return { error: 'title must be 1-300 characters' };\n    out.title = f.title.trim();\n  }\n  if ('status' in f) {\n    if (!STATUS.includes(f.status)) return { error: 'status must be one of ' + STATUS.join(', ') };\n    out.status = f.status;\n  }\n  if ('dueAt' in f) {\n    if (f.dueAt !== null && !isIso(f.dueAt)) return { error: 'dueAt must be ISO 8601 or null' };\n    out.dueAt = f.dueAt;\n  }\n  if ('assigneeId' in f) {\n    if (f.assigneeId !== null && (typeof f.assigneeId !== 'string' || f.assigneeId.length > 100)) return { error: 'assigneeId must be an id or null' };\n    out.assigneeId = f.assigneeId;\n  }\n  if ('bodyMarkdown' in f) {\n    if (f.bodyMarkdown !== null && (typeof f.bodyMarkdown !== 'string' || f.bodyMarkdown.length > 20000)) return { error: 'bodyMarkdown must be text up to 20000 characters' };\n    out.bodyV2 = { markdown: f.bodyMarkdown, blocknote: null };\n  }\n  return { fields: out };\n}\nconst idOk = (id) => typeof id === 'string' && /^[A-Za-z0-9-]{1,100}$/.test(id);\n\nif (op === 'create') {\n  const offlineId = body.offlineId;\n  if (typeof offlineId !== 'string' || !/^[A-Za-z0-9-]{8,100}$/.test(offlineId)) return fail('VALIDATION_ERROR', 'offlineId (uuid) is required for create');\n  const p = pickFields(body.fields);\n  if (p.error) return fail('VALIDATION_ERROR', p.error);\n  if (!p.fields.title) return fail('VALIDATION_ERROR', 'fields.title is required for create');\n  if (!p.fields.status) p.fields.status = 'TODO';\n  const dedupeKey = 'dash-tasks-write:' + offlineId;\n  const filter = { type: 'and', filters: [{ columnName: 'request_id', condition: 'eq', value: dedupeKey }] };\n  return [{ json: { valid: true, op, request_id, dedupe: true, dedupeKey, hasBody: true,\n    dedupeLookupUrl: 'http://localhost:5678/api/v1/data-tables/RaOJmGMJFdZHIVRm/rows?limit=1&filter=' + encodeURIComponent(JSON.stringify(filter)),\n    req: { method: 'POST', url: BASE, body: p.fields } } }];\n}\nif (!idOk(body.id)) return fail('VALIDATION_ERROR', 'id is required');\nif (op === 'update') {\n  const p = pickFields(body.fields);\n  if (p.error) return fail('VALIDATION_ERROR', p.error);\n  if (Object.keys(p.fields).length === 0) return fail('VALIDATION_ERROR', 'nothing to update');\n  return [{ json: { valid: true, op, id: body.id, request_id, dedupe: false, hasBody: true,\n    req: { method: 'PATCH', url: BASE + '/' + encodeURIComponent(body.id), body: p.fields } } }];\n}\nreturn [{ json: { valid: true, op, id: body.id, request_id, dedupe: false, hasBody: false,\n  req: { method: 'DELETE', url: BASE + '/' + encodeURIComponent(body.id) } } }];\n"
      },
