      "parameters": {
        "jsCode": "// A create repeated with the same offlineId returns the first result (CONTRACT.md \u00a71.12).\nconst v = $('Validate Input').first().json;\nconst r = $input.first().json || {};\nconst rows = (r.statusCode >= 200 && r.statusCode < 300 && r.body && Array.isArray(r.body.data)) ? r.body.data : [];\nif (rows.length > 0) {\n  let stored;\n  try { stored = JSON.parse(rows[0].response_json); } catch (e) { stored = { ok: true, request_id: v.request_id, data: { op: 'create', id: rows[0].resource_id } }; }\n  stored.duplicate = true;\n  return [{ json: { done: true, response: stored } }];\n}\nreturn [{ json: Object.assign({}, v, { done: false }) }];\n"
