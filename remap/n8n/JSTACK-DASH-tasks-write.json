    {
      "parameters": {
        "jsCode": "const v = $('Validate Input').first().json;\nconst r = $input.first().json || {};\nconst sc = r.statusCode;\nconst err = (code, message, status_code) => [{ json: { ok: false, status_code, request_id: v.request_id, error: { code, message } } }];\nconst detail = () => JSON.stringify(r.body || '').slice(0, 300);\nif (sc === 404) return err('NOT_FOUND', 'task not found', 404);\nif (sc === 400 || sc === 422) return err('VALIDATION_ERROR', 'Twenty refused the change: ' + detail(), 422);\nif (!(sc >= 200 && sc < 300)) return err('UPSTREAM_ERROR', 'Twenty answered ' + sc + ': ' + detail(), 502);\n// Twenty REST answers { data: { createTask | updateTask | deleteTask: {...} } }\nconst d = (r.body && r.body.data) || {};\nconst rec = Object.values(d).find((x) => x && typeof x === 'object') || null;\nconst response = { ok: true, request_id: v.request_id, data: { op: v.op, id: (rec && rec.id) || v.id || null, task: v.op === 'delete' ? null : rec } };\nreturn [{ json: {\n  ok: true, response,\n  writeDedupe: v.op === 'create',\n  dedupeRow: v.op === 'create' ? { request_id: v.dedupeKey, workflow: 'JSTACK-DASH-tasks-write', resource_id: String((rec && rec.id) || ''), response_json: JSON.stringify(response), created_at: new Date().toISOString() } : null\n} }];\n"
