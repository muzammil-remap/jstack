        "jsCode": "// One page of Twenty people (read-only). Twenty REST pages at 60.\nconst first = $input.first().json;\nconst body = first.body || first;\nconst request_id = (typeof body.request_id === 'string' && body.request_id.length <= 100) ? body.request_id : undefined;\nconst fail = (code, message, status_code = 400) => [{ json: { valid: false, status_code, error: { code, message }, request_id } }];\nconst isIso = (v) => typeof v === 'string' && v.trim() !== '' && !isNaN(new Date(v).getTime());\nlet limit = parseInt(body.limit ?? 60, 10);\nif (isNaN(limit)) return fail('VALIDATION_ERROR', 'limit must be a number');\nlimit = Math.max(1, Math.min(60, limit));\nconst cursor = body.cursor == null || body.cursor === '' ? null : String(body.cursor);\nif (cursor !== null && cursor.length > 500) return fail('VALIDATION_ERROR', 'cursor too long');\nconst url = 'http://172.17.0.1:3000/rest/people?limit=' + limit + (cursor ? '&starting_after=' + encodeURIComponent(cursor) : '');\nreturn [{ json: { valid: true, request_id, req: { url }, _startTime: Date.now() } }];\n"
