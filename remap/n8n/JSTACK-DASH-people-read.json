      "parameters": {
        "jsCode": "// Pass Twenty's records through unchanged; the app's adapter maps them.\nconst v = $('Validate Input').first().json;\nconst r = $input.first().json || {};\nconst sc = r.statusCode;\nif (!(sc >= 200 && sc < 300)) {\n  return [{ json: { ok: false, status_code: 502, request_id: v.request_id, error: { code: 'UPSTREAM_ERROR', message: 'Twenty answered ' + sc + ': ' + JSON.stringify(r.body || '').slice(0, 300) } } }];\n}\nconst b = r.body || {};\nconst rows = (b.data && Array.isArray(b.data.people)) ? b.data.people : [];\nreturn [{ json: { ok: true, response: {\n  ok: true, request_id: v.request_id, duration_ms: Date.now() - (v._startTime || Date.now()),\n  data: { count: rows.length, totalCount: b.totalCount ?? null, pageInfo: b.pageInfo || null, people: rows }\n} } }];\n"
