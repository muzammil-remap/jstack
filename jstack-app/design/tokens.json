{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "JSTACK design tokens v1.0. Light values at the top level; dark overrides under $extensions.jstack.dark. Matches tokens/*.css.",
  "color": {
    "ground": { "$type": "color", "$value": "#E9E7E0", "$extensions": { "jstack": { "dark": "#191815" } } },
    "card": { "$type": "color", "$value": "rgba(255,255,255,0.72)", "$extensions": { "jstack": { "dark": "rgba(255,255,255,0.08)", "blur": "20px" } } },
    "cardBorder": { "$type": "color", "$value": "rgba(255,255,255,0.85)", "$extensions": { "jstack": { "dark": "rgba(255,255,255,0.10)" } } },
    "bar": { "$type": "color", "$value": "rgba(255,255,255,0.82)", "$extensions": { "jstack": { "dark": "rgba(40,38,34,0.90)", "blur": "24px" } } },
    "hairline": { "$type": "color", "$value": "rgba(43,42,38,0.08)", "$extensions": { "jstack": { "dark": "rgba(255,255,255,0.08)" } } },
    "ink": { "$type": "color", "$value": "#2B2A26", "$extensions": { "jstack": { "dark": "#ECE9E2" } } },
    "muted": { "$type": "color", "$value": "#7A776F", "$extensions": { "jstack": { "dark": "#93908A" } } },
    "accent": { "$type": "color", "$value": "#66798A", "$extensions": { "jstack": { "dark": "#9AAEC0" } } },
    "accentSoft": { "$type": "color", "$value": "rgba(102,121,138,0.14)", "$extensions": { "jstack": { "dark": "rgba(154,174,192,0.16)" } } },
    "accentInk": { "$type": "color", "$value": "#4A5E70", "$extensions": { "jstack": { "dark": "#B7C8D8" } } },
    "marker": { "$type": "color", "$value": "#4F7FA8", "$extensions": { "jstack": { "dark": "#7FA9CF", "use": "count badges and the live mic only" } } },
    "ok": { "$type": "color", "$value": "#4F8A6B", "$extensions": { "jstack": { "dark": "#7DBF9C" } } },
    "alert": { "$type": "color", "$value": "#B0553F", "$extensions": { "jstack": { "dark": "#D9785E" } } },
    "selected": { "$type": "color", "$value": "#2B2A26", "$extensions": { "jstack": { "dark": "#ECE9E2", "use": "undo toast" } } },
    "onSelected": { "$type": "color", "$value": "#F4F3EE", "$extensions": { "jstack": { "dark": "#191815" } } }
  },
  "shadow": {
    "card": { "$type": "shadow", "$value": [ { "offsetX": "0px", "offsetY": "14px", "blur": "36px", "spread": "0px", "color": "rgba(60,55,45,0.12)" }, { "offsetX": "0px", "offsetY": "2px", "blur": "6px", "spread": "0px", "color": "rgba(60,55,45,0.05)" } ], "$extensions": { "jstack": { "dark": [ { "offsetX": "0px", "offsetY": "18px", "blur": "44px", "spread": "0px", "color": "rgba(0,0,0,0.55)" } ] } } },
    "segment": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px", "color": "rgba(60,55,45,0.14)" } }
  },
  "font": {
    "body": { "$type": "fontFamily", "$value": ["Instrument Sans", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "sans-serif"] },
    "heading": { "$type": "fontFamily", "$value": ["Source Serif 4", "Georgia", "serif"] },
    "icon": { "$type": "fontFamily", "$value": ["Material Symbols Rounded"], "$extensions": { "jstack": { "weight": 300, "fill": 0, "fillActive": 1 } } }
  },
  "fontWeight": {
    "regular": { "$type": "fontWeight", "$value": 400 },
    "emphasis": { "$type": "fontWeight", "$value": 500 },
    "wordmark": { "$type": "fontWeight", "$value": 600 }
  },
  "fontSize": {
    "titleDesktop": { "$type": "dimension", "$value": "32px" },
    "titlePhone": { "$type": "dimension", "$value": "26px" },
    "stat": { "$type": "dimension", "$value": "22px" },
    "cardTitle": { "$type": "dimension", "$value": "15px" },
    "body": { "$type": "dimension", "$value": "12.5px" },
    "chip": { "$type": "dimension", "$value": "12px" },
    "label": { "$type": "dimension", "$value": "11.5px" },
    "small": { "$type": "dimension", "$value": "11px" },
    "meta": { "$type": "dimension", "$value": "10.5px" },
    "tab": { "$type": "dimension", "$value": "10px" },
    "badge": { "$type": "dimension", "$value": "10px" }
  },
  "lineHeight": {
    "tight": { "$type": "number", "$value": 1 },
    "stat": { "$type": "number", "$value": 1.1 },
    "title": { "$type": "number", "$value": 1.3 },
    "row": { "$type": "number", "$value": 1.35 },
    "body": { "$type": "number", "$value": 1.4 }
  },
  "letterSpacing": {
    "title": { "$type": "dimension", "$value": "-0.01em" },
    "label": { "$type": "dimension", "$value": "0.08em" },
    "wordmark": { "$type": "dimension", "$value": "0.16em" }
  },
  "radius": {
    "card": { "$type": "dimension", "$value": "10px" },
    "control": { "$type": "dimension", "$value": "8px" },
    "segment": { "$type": "dimension", "$value": "9px" },
    "tag": { "$type": "dimension", "$value": "5px" },
    "round": { "$type": "dimension", "$value": "50%" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "2px" },
    "2": { "$type": "dimension", "$value": "6px" },
    "3": { "$type": "dimension", "$value": "8px" },
    "4": { "$type": "dimension", "$value": "9px" },
    "5": { "$type": "dimension", "$value": "10px" },
    "6": { "$type": "dimension", "$value": "12px" },
    "7": { "$type": "dimension", "$value": "16px" },
    "8": { "$type": "dimension", "$value": "18px" },
    "9": { "$type": "dimension", "$value": "24px" },
    "10": { "$type": "dimension", "$value": "32px" }
  },
  "size": {
    "iconButton": { "$type": "dimension", "$value": "32px" },
    "iconButtonInCard": { "$type": "dimension", "$value": "36px" },
    "mic": { "$type": "dimension", "$value": "44px" },
    "micLive": { "$type": "dimension", "$value": "42px" },
    "habit": { "$type": "dimension", "$value": "36px" },
    "checkbox": { "$type": "dimension", "$value": "15px" },
    "dot": { "$type": "dimension", "$value": "6px" },
    "badgeHeight": { "$type": "dimension", "$value": "16px" },
    "labelColumn": { "$type": "dimension", "$value": "48px" },
    "railWidth": { "$type": "dimension", "$value": "200px" },
    "barHeight": { "$type": "dimension", "$value": "60px" },
    "barInset": { "$type": "dimension", "$value": "14px" },
    "contentMax": { "$type": "dimension", "$value": "1500px" }
  },
  "icon": {
    "tab": { "$type": "dimension", "$value": "21px" },
    "rail": { "$type": "dimension", "$value": "18px" },
    "header": { "$type": "dimension", "$value": "17px" },
    "inline": { "$type": "dimension", "$value": "16px" },
    "chip": { "$type": "dimension", "$value": "14px" }
  },
  "breakpoint": {
    "tablet": { "$type": "dimension", "$value": "768px" },
    "desktop": { "$type": "dimension", "$value": "1180px" }
  },
  "grid": {
    "three": { "$type": "string", "$value": "1.3fr 1fr .95fr" },
    "two": { "$type": "string", "$value": "1.3fr 1fr" }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "80ms" },
    "base": { "$type": "duration", "$value": "160ms" },
    "open": { "$type": "duration", "$value": "200ms" },
    "pulse": { "$type": "duration", "$value": "1400ms" },
    "undo": { "$type": "duration", "$value": "10000ms" },
    "ease": { "$type": "cubicBezier", "$value": [0.2, 0.7, 0.2, 1] }
  },
  "iconName": {
    "today": { "$type": "string", "$value": "wb_sunny" },
    "tasks": { "$type": "string", "$value": "task_alt" },
    "brain": { "$type": "string", "$value": "neurology" },
    "life": { "$type": "string", "$value": "explore" },
    "agents": { "$type": "string", "$value": "hub" },
    "find": { "$type": "string", "$value": "search" },
    "settings": { "$type": "string", "$value": "settings" },
    "arrange": { "$type": "string", "$value": "grid_view" },
    "help": { "$type": "string", "$value": "help" },
    "themeToDark": { "$type": "string", "$value": "dark_mode" },
    "themeToLight": { "$type": "string", "$value": "light_mode" },
    "filter": { "$type": "string", "$value": "tune" },
    "more": { "$type": "string", "$value": "more_horiz" },
    "open": { "$type": "string", "$value": "chevron_right" },
    "send": { "$type": "string", "$value": "arrow_upward" },
    "voice": { "$type": "string", "$value": "mic" },
    "type": { "$type": "string", "$value": "keyboard" }
  }
}
