{
  "name": "jstack-app",
  "version": "1.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "web:n8n": "node tools/web-n8n.mjs",
    "ios": "expo start --ios",
    "check": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "test:e2e": "node tools/run-e2e.mjs",
    "test:e2e:targeted": "playwright test --reporter=list",
    "build:web": "node tools/build-web.mjs",
    "serve:web": "node tools/serve-web.mjs",
    "build:web:prod": "node tools/build-web.mjs --prod",
    "build:web:swap": "node tools/build-web.mjs --swap",
    "serve:mock": "node tools/serve-mock.mjs",
    "connect:check": "node tools/connect-check.mjs",
    "fonts": "node tools/vendor-fonts.mjs",
    "unused": "node tools/unused-exports.mjs",
    "codemap": "node tools/gen-wiring.mjs && node tools/gen-wiring-html.mjs && node tools/gen-openapi.mjs && node tools/gen-backend-grep.mjs && node tools/gen-parameters.mjs && node tools/gen-handover-html.mjs && node tools/gen-codemap.mjs",
    "prepare": "node tools/install-hooks.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/instrument-sans": "^0.4.1",
    "@expo-google-fonts/source-serif-4": "^0.4.1",
    "@noble/ciphers": "^2.4.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~54.0.29",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.12",
    "expo-font": "~14.0.10",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "~8.0.10",
    "expo-local-authentication": "~17.0.7",
    "expo-router": "~6.0.19",
    "expo-secure-store": "~15.0.8",
    "expo-speech-recognition": "~3.1.3",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@material-symbols/svg-300": "^0.35.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.3",
    "@types/react": "~19.1.17",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~10.0.0",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.0",
    "react-test-renderer": "19.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": ">=8.5.23",
      "decode-uri-component@<0.5.0": ">=0.5.0"
    }
  }
}
